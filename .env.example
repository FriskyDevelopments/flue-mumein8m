# Default model for every agent. Use the provider/model-id format.
# Examples:
#   anthropic/claude-sonnet-4-6
#   openai/gpt-5.5
#   openrouter/moonshotai/kimi-k2.6
MODEL_ID=anthropic/claude-sonnet-4-6

# Provider API keys — supply the key that matches your MODEL_ID's provider.
ANTHROPIC_API_KEY=

# Optional — only needed if you switch MODEL_ID to a different provider.
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
