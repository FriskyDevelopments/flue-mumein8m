# Default model for every agent. Use the provider/model-id format.
# Examples:
#   anthropic/claude-sonnet-4-6
#   openai/gpt-5.5
#   openrouter/moonshotai/kimi-k2.6
MODEL_ID=anthropic/claude-sonnet-4-6

# Provider API keys — supply the key that matches your MODEL_ID's provider.
ANTHROPIC_API_KEY=

# Optional — only needed if you switch MODEL_ID to a different provider.
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=

# Shared secret every request must send as "secret" in the JSON body.
# Requests are rejected when this is unset. Generate with: openssl rand -hex 32
FLUE_SECRET=

# Optional — route MODEL_ID's provider through your own LLM gateway
# (LiteLLM-style proxy / metered token service). The gateway receives the
# provider's normal API (e.g. POST <base>/chat/completions for deepseek/openai)
# with the model id from MODEL_ID and "Authorization: Bearer <LLM_API_KEY>".
# LLM_BASE_URL=https://llm.example.com/v1
# LLM_API_KEY=
